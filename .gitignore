# --- Session output: PERSONAL DATA, never commit ---
# Snapshots are photographs of the student, and the log labels them with
# alert types. Both are regenerated by running the app, so nothing is lost
# by keeping them out of version control.
incidents/
incidents_log.csv

# --- Virtual environment ---
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Model weights ---
# yolov8n.pt is ~6 MB and ultralytics downloads it automatically on first
# run, so there is no reason to carry it in the repo.
*.pt

# --- Local tool / editor settings ---
.claude/
.vscode/
.idea/

# --- Setup backups ---
*.bak
